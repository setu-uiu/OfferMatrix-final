generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // "ADMIN", "USER", "MERCHANT"
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                       String          @id @default(uuid())
  email                    String          @unique
  name                     String
  password                 String?
  phone                    String?         @unique
  avatar                   String?
  status                   String          @default("Active") // "Active", "Reported", "Suspended"
  subscriptionPlan         String          @default("free") // "free", "pro", "vip"
  isEmailVerified          Boolean         @default(false)
  verificationToken        String?
  verificationTokenExpires DateTime?
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  roleId                   String?
  role                     Role?           @relation(fields: [roleId], references: [id])
  savedDeals               SavedDeal[]
  priceAlerts              PriceAlert[]
  complaints               Complaint[]
  reviews                  Review[]
  notifications            Notification[]
  auditLogs                AdminAuditLog[]
  orders                   FoodOrder[]
  rides                    RideTrip[]
  skincareOrders           SkincareOrder[]
  deliveryAssignments      DeliveryAssignment[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
}

model Merchant {
  id         String   @id @default(uuid())
  name       String
  category   String   // "Food", "Rides", "Skincare", etc.
  logo       String?
  rating     Float    @default(5.0)
  totalDeals Int      @default(0)
  contact    String?
  status     String   @default("Active") // "Active", "Pending", "Suspended"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model FoodDeal {
  id            String   @id @default(uuid())
  title         String
  restaurant    String
  bestPrice     Float
  originalPrice Float
  savings       Float
  tag           String?
  image         String
  rating        Float    @default(4.8)
  reviewsCount  Int      @default(100)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RideDeal {
  id            String   @id @default(uuid())
  title         String
  route         String
  cheapestPrice Float
  originalPrice Float
  savings       Float
  tag           String?
  image         String
  rating        Float    @default(4.8)
  reviewsCount  Int      @default(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SkincareDeal {
  id            String   @id @default(uuid())
  title         String
  brand         String
  bestPrice     Float
  originalPrice Float
  savings       Float
  tag           String?
  image         String
  rating        Float    @default(4.9)
  reviewsCount  Int      @default(100)
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Offer {
  id              String   @id @default(uuid())
  platform        String   // Canonical: foodpanda, foodi, pathao_food, uber, obhai, indrive, choice_legacy, kirei, makeup_chari

  title           String
  discount        String
  validTill       String
  status          String   @default("Active") // "Active", "Expired"
  code            String
  category        String?
  merchantName    String?
  claimProgress   Int?     @default(0)
  isFlash         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Coupon {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  platform    String
  minOrder    String
  expiry      String
  category    String
  bg          String?
  borderColor String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BankOffer {
  id          String   @id @default(uuid())
  bankName    String   // e.g. "BRAC Bank", "City Bank", "EBL", "Standard Chartered"
  cardType    String   // "Credit", "Debit", "Visa", "Mastercard", "Amex"
  offerTitle  String
  discount    String
  validTill   String
  code        String?
  bannerImage String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BkashOffer {
  id          String   @id @default(uuid())
  title       String
  discount    String
  cashback    String?
  merchant    String?
  code        String
  validTill   String
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NagadOffer {
  id          String   @id @default(uuid())
  title       String
  discount    String
  cashback    String?
  merchant    String?
  code        String
  validTill   String
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RocketOffer {
  id          String   @id @default(uuid())
  title       String
  discount    String
  cashback    String?
  merchant    String?
  code        String
  validTill   String
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SavedDeal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId    String
  category  String
  title     String
  price     Float
  image     String?
  createdAt DateTime @default(now())
}

model PriceAlert {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId      String
  title       String
  targetPrice Float
  channel     String   @default("Email") // "Email", "SMS", "WhatsApp", "Push"
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Complaint {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  subCategory String?  // e.g., "Skincare", "Food", "Wallet", "Rides"
  status      String   @default("Open") // "Open", "Resolved", "Under Review"
  date        String
  details     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId    String
  category  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  title     String
  message   String
  type      String   @default("system") // "system", "deal", "alert"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action    String
  target    String?
  details   String?
  date      String
  color     String?  @default("#3b82f6")
  createdAt DateTime @default(now())
}

model DeliveryPartner {
  id                  String                    @id @default(uuid())
  name                String
  phone               String
  email               String?
  avatar              String?
  partnerCode         String?
  vehicle             String?
  vehicleType         String?
  vehicleModel        String?
  vehicleRegistration String?
  licensePlate        String?
  totalDeliveries     Int                       @default(0)
  rating              Float                     @default(4.9)
  status              String                    @default("AVAILABLE") // "AVAILABLE", "BUSY", "OFFLINE", "SUSPENDED"
  isVerified          Boolean                   @default(true)
  isSuspended         Boolean                   @default(false)
  joinedAt            DateTime                  @default(now())
  orders              FoodOrder[]
  skincareOrders      SkincareOrder[]
  assignments         DeliveryAssignment[]
  locations           DeliveryPartnerLocation[]
  earnings            DeliveryPartnerEarning[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
}

model FoodOrder {
  id                String                   @id @default(uuid())
  orderNumber       String                   @unique // Format: OM-YYYYMMDD-XXXX
  userId            String
  user              User                     @relation(fields: [userId], references: [id])
  merchantName      String?                  // e.g. "Kacchi Bhai - Dhanmondi"
  category          String                   @default("food")
  status            String                   @default("PENDING") // PENDING, CONFIRMED, PREPARING, READY_FOR_PICKUP, PICKED_UP, ON_THE_WAY, DELIVERED, CANCELLED
  subtotal          Decimal                  @db.Decimal(10, 2)
  deliveryFee       Decimal                  @default(30.00) @db.Decimal(10, 2)
  discount          Decimal                  @default(0.00) @db.Decimal(10, 2)
  couponCode        String?
  paymentMethod     String                   @default("Cash on Delivery")
  totalAmount       Decimal                  @db.Decimal(10, 2)
  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner?         @relation(fields: [deliveryPartnerId], references: [id])
  assignedAt        DateTime?
  pickedUpAt        DateTime?
  onTheWayAt        DateTime?
  deliveredAt       DateTime?
  deliveryAddress   String?
  deliveryArea      String?
  deliveryPhone     String?
  deliveryLatitude  Float?
  deliveryLongitude Float?
  items             FoodOrderItem[]
  assignments       DeliveryAssignment[]
  earnings          DeliveryPartnerEarning[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

model FoodOrderItem {
  id          String    @id @default(uuid())
  orderId     String
  order       FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodDealId  String?
  name        String
  quantity    Int       @default(1)
 unitPrice   Decimal   @db.Decimal(10, 2)
  totalPrice  Decimal   @db.Decimal(10, 2)
  image       String?
  selectedApp String?
  createdAt   DateTime  @default(now())
}

model RideTrip {
  id               String   @id @default(uuid())
  tripNumber       String   @unique // Format: RIDE-YYYYMMDD-XXXX
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  platform         String   // uber, obhai, indrive
  pickup           String
  destination      String
  distanceKm       Float?
  durationMins     Int?
  carType          String   @default("Car / Sedan (AC)")
  baseFare         Decimal  @db.Decimal(10, 2)
  discount         Decimal  @default(0.00) @db.Decimal(10, 2)
  finalFare        Decimal  @db.Decimal(10, 2)
  promoCode        String?
  status           String   @default("REQUESTED") // REQUESTED, CONFIRMED, DRIVER_ASSIGNED, DRIVER_ARRIVING, PICKED_UP, IN_TRIP, COMPLETED, CANCELLED
  driverName       String?
  driverPhone      String?
  vehicleModel     String?
  vehicleRegNumber String?
  driverRating     Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SkincareOrder {
  id                String                   @id @default(uuid())
  orderNumber       String                   @unique // Format: SKIN-YYYYMMDD-XXXX
  userId            String
  user              User                     @relation(fields: [userId], references: [id])
  storePlatform     String                   // choice_legacy, kirei, makeup_chari
  status            String                   @default("PENDING") // PENDING, CONFIRMED, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  subtotal          Decimal                  @db.Decimal(10, 2)
  deliveryFee       Decimal                  @default(50.00) @db.Decimal(10, 2)
  discount          Decimal                  @default(0.00) @db.Decimal(10, 2)
  couponCode        String?
  paymentMethod     String                   @default("bKash")
  totalAmount       Decimal                  @db.Decimal(10, 2)
  deliveryPartnerId String?
  deliveryPartner   DeliveryPartner?         @relation(fields: [deliveryPartnerId], references: [id])
  assignedAt        DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  deliveryAddress   String?
  deliveryArea      String?
  deliveryPhone     String?
  deliveryLatitude  Float?
  deliveryLongitude Float?
  items             SkincareOrderItem[]
  assignments       DeliveryAssignment[]
  earnings          DeliveryPartnerEarning[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

model SkincareOrderItem {
  id          String        @id @default(uuid())
  orderId     String
  order       SkincareOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  name        String
  brand       String?
  quantity    Int           @default(1)
  unitPrice   Decimal       @db.Decimal(10, 2)
  totalPrice  Decimal       @db.Decimal(10, 2)
  image       String?
  createdAt   DateTime      @default(now())
}

model DeliveryAssignment {
  id                String          @id @default(uuid())
  deliveryPartnerId String
  deliveryPartner   DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)
  foodOrderId       String?
  foodOrder         FoodOrder?      @relation(fields: [foodOrderId], references: [id], onDelete: SetNull)
  skincareOrderId   String?
  skincareOrder     SkincareOrder?  @relation(fields: [skincareOrderId], references: [id], onDelete: SetNull)
  assignedByAdminId String?
  assignedByAdmin   User?           @relation(fields: [assignedByAdminId], references: [id], onDelete: SetNull)
  status            String          @default("ASSIGNED") // ASSIGNED, REASSIGNED, COMPLETED, CANCELLED
  assignedAt        DateTime        @default(now())
  unassignedAt      DateTime?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model DeliveryPartnerLocation {
  id                String          @id @default(uuid())
  deliveryPartnerId String
  deliveryPartner   DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)
  latitude          Float
  longitude         Float
  accuracy          Float?
  recordedAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())
}

model DeliveryPartnerEarning {
  id                 String          @id @default(uuid())
  deliveryPartnerId  String
  deliveryPartner    DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)
  foodOrderId        String?
  foodOrder          FoodOrder?      @relation(fields: [foodOrderId], references: [id], onDelete: SetNull)
  skincareOrderId    String?
  skincareOrder      SkincareOrder?  @relation(fields: [skincareOrderId], references: [id], onDelete: SetNull)
  orderType          String          // "food", "skincare"
  grossAmount        Decimal         @db.Decimal(10, 2)
  deliveryFee        Decimal         @db.Decimal(10, 2)
  platformCommission Decimal         @default(0.00) @db.Decimal(10, 2)
  partnerEarning     Decimal         @db.Decimal(10, 2)
  status             String          @default("EARNED") // "EARNED", "PAID"
  earnedAt           DateTime        @default(now())
  paidAt             DateTime?
  createdAt          DateTime        @default(now())
}


